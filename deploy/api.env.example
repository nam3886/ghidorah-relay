# Names only. Copy to deploy/api.env and fill in on the box; the real file is never committed (gitignored).
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=
CREDENTIAL_SEAL_PUBLIC_KEY=
# The public address and the trusted proxies are settings (Settings, General), the billing timezone is the pin the
# first `relay migrate` wrote, and the port is 8100 (deploy/compose.yml): none of them is a variable.
