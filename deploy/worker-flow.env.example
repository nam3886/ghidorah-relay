# Names only. Copy to deploy/worker-flow.env and fill in on the box; the real file is never committed (gitignored).
# FLOW_YESCAPTCHA_KEY is the YesCaptcha client key (the reCAPTCHA token source of flow.captcha_provider=yescaptcha):
# a secret of this worker only, read once at start and removed from the environment.
DATABASE_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=
CREDENTIAL_SEAL_PRIVATE_KEY=
BILLING_TZ=
FLOW_YESCAPTCHA_KEY=
